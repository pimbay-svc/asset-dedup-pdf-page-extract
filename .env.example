# development | production | test
NODE_ENV=production

# Log level for pino (trace|debug|info|warn|error|fatal|silent).
LOG_LEVEL=info

# Path of the Unix domain socket this extension listens on. Must be on a
# volume shared with asset-dedup-core (core connects to it as a client).
SOCKET_PATH=./var/dev/pdf-page-extract.sock

# Base directory of the volume shared with asset-dedup-core: source PDFs
# are read from here, extracted pages are written here.
SHARED_VOLUME_DIR=./var/dev/shared

# Subdirectory (under SHARED_VOLUME_DIR) this extension writes extracted
# pages into. Defaults to SHARED_VOLUME_DIR/pdf-page-extract if unset.
# OUTPUT_DIR=./var/dev/shared/pdf-page-extract

# Paths to the pdftoppm/pdfinfo binaries (poppler-utils). Default to relying on PATH.
# PDFTOPPM_BIN=pdftoppm
# PDFINFO_BIN=pdfinfo

# Hard timeout (ms) for a single pdftoppm/pdfinfo invocation (page-count
# probe or a single page render).
# PDF_RENDER_TIMEOUT_MS=15000

# Background TTL sweep of OUTPUT_DIR — defensive backstop if core crashes
# mid-pipeline before consuming/deleting our output.
# TTL_SWEEP_INTERVAL_MS=300000
# TTL_RETENTION_MS=3600000
